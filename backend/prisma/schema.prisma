// Prisma schema — see docs/DATABASE.md for ER diagram.

generator client {
  provider      = "prisma-client-js"
  // "native" covers both the host machine and the debian-slim container
  // we run inside. Avoid alpine — Prisma's libssl detection is flaky there.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ATHLETE
  COACH
  RESEARCHER
  ADMIN
}

enum SessionSource {
  WEBCAM
  UPLOAD
}

enum SessionStatus {
  ACTIVE
  PROCESSING
  COMPLETED
  FAILED
}

enum PredictionKind {
  POSTURE
  ACTIVITY
  INJURY_RISK
  FORM
  SPRINT_PHASE
  TECHNIQUE_ERROR
  PERFORMANCE
}

enum SprintEvent {
  S100M
  S200M
  S400M
  RELAY
  PRACTICE
}

enum ConsentScope {
  TRAINING_DATA      // can be used to train SprintAI models
  RESEARCH_RELEASE   // can be released as part of a research dataset
  COACH_VISIBILITY   // coach may view full unblurred data
  PUBLIC_RANKING     // included in the Global Talent Map rankings
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  passwordHash  String         @map("password_hash")
  displayName   String         @map("display_name")
  role          Role           @default(USER)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  sessions      Session[]
  refreshTokens RefreshToken[]
  // Coaches own a roster of athletes. An athlete is also a User in their
  // own right (they can log in), but their performance record lives in
  // Athlete so the coach has a canonical place to attach goals + notes.
  coachedAthletes Athlete[] @relation("CoachedBy")
  athleteProfile  Athlete?  @relation("AthleteUser")

  @@map("user")
}

model Athlete {
  id          String       @id @default(uuid()) @db.Uuid
  // Optional link to the User account that "is" this athlete. Self-coached
  // athletes set it to their own user id; coach-managed athletes leave it
  // null until the athlete signs up.
  userId      String?      @unique @map("user_id") @db.Uuid
  coachId     String?      @map("coach_id") @db.Uuid
  fullName    String       @map("full_name")
  dateOfBirth DateTime?    @map("date_of_birth") @db.Date
  sex         String?      // "M" | "F" | "X" — left as free string for inclusivity
  heightCm    Float?       @map("height_cm")
  weightKg    Float?       @map("weight_kg")
  country     String?      // ISO 3166-1 alpha-2 (e.g. "UG" for Uganda)
  primaryEvent SprintEvent @default(S100M) @map("primary_event")
  notes       String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  user        User?        @relation("AthleteUser", fields: [userId], references: [id], onDelete: SetNull)
  coach       User?        @relation("CoachedBy", fields: [coachId], references: [id], onDelete: SetNull)
  sessions    Session[]

  @@index([coachId])
  @@index([country])
  @@map("athlete")
}

model Consent {
  id          String       @id @default(uuid()) @db.Uuid
  athleteId   String       @map("athlete_id") @db.Uuid
  // Who recorded the consent (athlete themselves, coach, guardian).
  grantedById String       @map("granted_by_id") @db.Uuid
  scope       ConsentScope
  granted     Boolean      @default(true)
  notes       String?
  // Version of the consent form text the user agreed to.
  formVersion String       @default("v1") @map("form_version")
  grantedAt   DateTime     @default(now()) @map("granted_at") @db.Timestamptz()
  revokedAt   DateTime?    @map("revoked_at") @db.Timestamptz()

  @@unique([athleteId, scope, formVersion])
  @@index([athleteId])
  @@map("consent")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_token")
}

model Session {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  // The session is "for" an athlete — defaults to the owner's own
  // athleteProfile when omitted (self-coached flow). Coaches set it
  // explicitly when uploading on behalf of someone on their roster.
  athleteId   String?        @map("athlete_id") @db.Uuid
  event       SprintEvent    @default(PRACTICE)
  label       String
  source      SessionSource
  status      SessionStatus  @default(ACTIVE)
  startedAt   DateTime       @default(now()) @map("started_at") @db.Timestamptz()
  endedAt     DateTime?      @map("ended_at") @db.Timestamptz()
  meta        Json           @default("{}")
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  athlete     Athlete?       @relation(fields: [athleteId], references: [id], onDelete: SetNull)
  videoAsset  VideoAsset?
  poseFrames  PoseFrame[]
  metrics     Metric[]
  predictions Prediction[]

  @@index([userId, startedAt(sort: Desc)])
  @@index([athleteId, startedAt(sort: Desc)])
  @@map("session")
}

model VideoAsset {
  id          String   @id @default(uuid()) @db.Uuid
  sessionId   String   @unique @map("session_id") @db.Uuid
  storagePath String   @map("storage_path")
  durationMs  Int?     @map("duration_ms")
  width       Int?
  height      Int?
  uploadedAt  DateTime @default(now()) @map("uploaded_at") @db.Timestamptz()
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("video_asset")
}

model PoseFrame {
  id         BigInt  @id @default(autoincrement())
  sessionId  String  @map("session_id") @db.Uuid
  frameIdx   Int     @map("frame_idx")
  tsMs       Int     @map("ts_ms")
  keypoints  Json
  confidence Float
  session    Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, frameIdx])
  @@map("pose_frame")
}

model Metric {
  id        BigInt  @id @default(autoincrement())
  sessionId String  @map("session_id") @db.Uuid
  name      String
  tsMs      Int     @map("ts_ms")
  value     Float
  meta      Json    @default("{}")
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, name, tsMs])
  @@map("metric")
}

model Prediction {
  id         BigInt         @id @default(autoincrement())
  sessionId  String         @map("session_id") @db.Uuid
  kind       PredictionKind
  tsMs       Int            @map("ts_ms")
  label      String
  confidence Float
  meta       Json           @default("{}")
  session    Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, kind, tsMs])
  @@map("prediction")
}
