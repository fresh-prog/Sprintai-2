# ============================================================
# SprintAI environment template — copy to `.env` and edit.
# ============================================================

# ---------- Core ----------
NODE_ENV=development
LOG_LEVEL=info

# ---------- Backend ----------
BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:5173

# ---------- Public HTTPS (docker-compose.https.yml only) ----------
# Your public domain with a DNS A record pointing at this server.
# DOMAIN=sprintai.example.com

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_WS_URL=http://localhost:4000

# ---------- Auth ----------
JWT_ACCESS_SECRET=change-me-access-32+chars-of-entropy
JWT_REFRESH_SECRET=change-me-refresh-32+chars-of-entropy
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=10

# ---------- Admin seed (optional) ----------
# If both are set, an ADMIN account is created/updated on every backend boot.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Postgres ----------
POSTGRES_USER=sprintai
POSTGRES_PASSWORD=sprintai_dev_pw
POSTGRES_DB=sprintai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sprintai:sprintai_dev_pw@postgres:5432/sprintai?schema=public

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ---------- Python services (HTTP, internal) ----------
ML_SERVICE_URL=http://ml:8001
BIOMECH_SERVICE_URL=http://biomech:8002

# ---------- Uploads ----------
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=200

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
